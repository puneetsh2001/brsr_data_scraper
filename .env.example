# Copy to .env and fill in real values. Never commit .env.

# ---- PostgreSQL (required for database phases) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brsr_db
DB_USER=postgres
DB_PASSWORD=change_me

# ---- MCA company master via data.gov.in (optional, free key) ----
# Register at https://www.data.gov.in to obtain a key; resource ids are shown
# on https://www.data.gov.in/catalog/company-master-data
# DATA_GOV_IN_API_KEY=your_key_here
# BRSR_DATAGOV_MCA_RESOURCE_IDS=resource-id-1,resource-id-2

# ---- Optional overrides (defaults in app/config/settings.py) ----
# BRSR_LOG_LEVEL=INFO
# BRSR_HTTP_TIMEOUT=90
# BRSR_HTTP_MAX_RETRIES=4
# BRSR_HTTP_BACKOFF_BASE=2.0
# BRSR_HTTP_BACKOFF_MAX=60
# BRSR_HTTP_MIN_INTERVAL_NSE_API=2.5
# BRSR_HTTP_MIN_INTERVAL_NSE_ARCHIVE=1.0
# BRSR_HTTP_CACHE_ENABLED=true
# BRSR_HTTP_CACHE_TTL_HOURS=24
# BRSR_COMPANY_UNIVERSE_FILE=data/raw/nse_nifty100_constituents.csv
# BRSR_COMPANY_FILTER=TITAN,INFY          # empty = all companies
# BRSR_FIRST_FY_SLOT=2021
# BRSR_DISCOVERY_YEARS=5
# BRSR_TAXONOMY_URL=https://nsearchives.nseindia.com/web/mediaattachment/2026-03/Taxonomy_BRSR_20260330194931.zip
